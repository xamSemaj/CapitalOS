@using System.Text.Json
@model CapitalOS.Models.StockSearchViewModel
@{
    ViewData["Title"] = "Markets — CapitalOS";
}

@* ── Ticker tape ── *@
<div class="ticker-wrap">
    <div class="ticker-label">LIVE</div>
    <div class="ticker-track" id="tickerTrack">
        @{
            /* Combine all three lists for a richer ticker */
            var allStocks = Model.MostActive
            .Concat(Model.TopGainers)
            .Concat(Model.TopLosers)
            .Take(12)
            .ToList();
        }
        @foreach (var t in allStocks)
        {
            <span class="tick-item">
                <span class="tick-sym">@t.Symbol</span>
                <span class="tick-price">$@t.Price.ToString("N2")</span>
                <span class="tick-chg @(t.ChangePercent >= 0 ? "pos" : "neg")">
                    @(t.ChangePercent >= 0 ? "+" : "")@t.ChangePercent.ToString("N2")%
                </span>
            </span>
        }
    </div>
</div>

@* ── Page shell ── *@
<div class="cap-page">
    <div class="cap-inner" style="display:flex;flex-direction:column;gap:1.4rem;">

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="market-error">@ViewBag.ErrorMessage</div>
        }

        @* ─────────────────────────────────────────
           INDEX BAR
           Replace hardcoded values with model data
           when you add a MarketIndices property.
        ─────────────────────────────────────────── *@
        <div class="index-bar" id="indexBar">
            @* Placeholder cards — swap for @Model.MarketIndices when available *@
            @{
                var indices = new[]
                {
                        new { Label = "S&P 500",   Value = "5,308", Chg = "+0.74%", Pos = true  },
                        new { Label = "NASDAQ",    Value = "16,742",Chg = "+1.12%", Pos = true  },
                        new { Label = "DOW JONES", Value = "39,814",Chg = "+0.31%", Pos = true  },
                        new { Label = "VIX",       Value = "14.28", Chg = "-3.50%", Pos = false },
                        };
            }
            @foreach (var idx in indices)
            {
                <div class="index-card">
                    <div class="idx-meta">
                        <div class="idx-label">@idx.Label</div>
                        <div class="idx-value">@idx.Value</div>
                    </div>
                    <div class="idx-spark">
                        @* Sparklines rendered by JS below *@
                        <canvas class="idx-spark-canvas" width="80" height="34"
                                data-positive="@idx.Pos.ToString().ToLower()"></canvas>
                    </div>
                    <span class="idx-change @(idx.Pos ? "pos" : "neg")">@idx.Chg</span>
                </div>
            }
        </div>

        @* ─────────────────────────────────────────
           SECTION HEADING
        ─────────────────────────────────────────── *@
        <div class="section-meta">
            <span class="section-title">Market Discovery</span>
            <a asp-controller="Stocks" asp-action="Index" class="section-link">
                View all stocks →
            </a>
        </div>

        @* ─────────────────────────────────────────
           DISCOVERY GRID  (3 columns)
        ─────────────────────────────────────────── *@
        <div class="discovery-grid">

            @* ── Column 1: Most Active ── *@
            <div class="discovery-col">
                <div class="col-heading">
                    <span class="col-dot blue"></span>
                    Most Tracked
                </div>

                @if (Model.MostActive.Any())
                {
                    var feat = Model.MostActive.First();
                    var pos = feat.ChangePercent >= 0;
                    <a asp-controller="Home"
                       asp-action="Index"
                       asp-route-symbol="@feat.Symbol"
                       class="featured-card"
                       data-positive="@pos.ToString().ToLower()">

                        @{
                            var featPointsJson = JsonSerializer.Serialize(feat.ChartPoints.Select(x => x.Price));
                        }

                        <canvas class="bg-spark"
                                data-points='@Html.Raw(featPointsJson)'></canvas>

                        <div>
                            <span class="featured-symbol">@feat.Symbol</span>
                            <span class="featured-name">@feat.CompanyName</span>
                        </div>

                        <div class="featured-price-row">
                            <div>
                                <div class="featured-price">$@feat.Price.ToString("N2")</div>
                            </div>
                            <span class="badge-chg @(pos ? "pos" : "neg")">
                                @(pos ? "▲" : "▼")
                                @(pos ? "+" : "")@feat.ChangePercent.ToString("N2")%
                            </span>
                        </div>
                    </a>

                    <div class="list-card">
                        @foreach (var stock in Model.MostActive.Skip(1).Take(4))
                        {
                            var sPos = stock.ChangePercent >= 0;
                            <a asp-controller="Home"
                               asp-action="Index"
                               asp-route-symbol="@stock.Symbol"
                               class="discovery-stock-row">
                                <div class="row-bar @(sPos ? "" : "neg")"></div>
                                <div class="row-info">
                                    <span class="row-sym">@stock.Symbol</span>
                                    <span class="row-co">@stock.CompanyName</span>
                                </div>
                                <div class="row-sparkline">
                                    @{
                                        var stockPointsJson = JsonSerializer.Serialize(stock.ChartPoints.Select(x => x.Price));
                                    }

                                    <canvas width="64" height="28"
                                            data-positive="@sPos.ToString().ToLower()"
                                            data-points='@Html.Raw(stockPointsJson)'
                                            class="row-spark-canvas"></canvas>
                                </div>
                                <div class="row-price-block">
                                    <span class="row-price">$@stock.Price.ToString("N2")</span>
                                    <span class="row-pct @(sPos ? "pos" : "neg")">
                                        @(sPos ? "+" : "")@stock.ChangePercent.ToString("N2")%
                                    </span>
                                </div>
                            </a>
                        }
                    </div>
                }
            </div>

            @* ── Column 2: Top Gainers ── *@
            <div class="discovery-col">
                <div class="col-heading">
                    <span class="col-dot green"></span>
                    Top Gainers
                </div>

                @if (Model.TopGainers.Any())
                {
                    var feat = Model.TopGainers.First();
                    var pos = feat.ChangePercent >= 0;
                    <a asp-controller="Home"
                       asp-action="Index"
                       asp-route-symbol="@feat.Symbol"
                       class="featured-card"
                       data-positive="@pos.ToString().ToLower()">

                        <canvas class="bg-spark"></canvas>

                        <div>
                            <span class="featured-symbol">@feat.Symbol</span>
                            <span class="featured-name">@feat.CompanyName</span>
                        </div>

                        <div class="featured-price-row">
                            <div>
                                <div class="featured-price">$@feat.Price.ToString("N2")</div>
                            </div>
                            <span class="badge-chg @(pos ? "pos" : "neg")">
                                @(pos ? "▲" : "▼")
                                @(pos ? "+" : "")@feat.ChangePercent.ToString("N2")%
                            </span>
                        </div>
                    </a>

                    <div class="list-card">
                        @foreach (var stock in Model.TopGainers.Skip(1).Take(4))
                        {
                            var sPos = stock.ChangePercent >= 0;
                            <a asp-controller="Home"
                               asp-action="Index"
                               asp-route-symbol="@stock.Symbol"
                               class="discovery-stock-row">
                                <div class="row-bar @(sPos ? "" : "neg")"></div>
                                <div class="row-info">
                                    <span class="row-sym">@stock.Symbol</span>
                                    <span class="row-co">@stock.CompanyName</span>
                                </div>
                                <div class="row-sparkline">
                                    <canvas width="64" height="28"
                                            data-positive="@sPos.ToString().ToLower()"
                                            class="row-spark-canvas"></canvas>
                                </div>
                                <div class="row-price-block">
                                    <span class="row-price">$@stock.Price.ToString("N2")</span>
                                    <span class="row-pct @(sPos ? "pos" : "neg")">
                                        @(sPos ? "+" : "")@stock.ChangePercent.ToString("N2")%
                                    </span>
                                </div>
                            </a>
                        }
                    </div>
                }
            </div>

            @* ── Column 3: Top Losers ── *@
            <div class="discovery-col">
                <div class="col-heading">
                    <span class="col-dot red"></span>
                    Top Losers
                </div>

                @if (Model.TopLosers.Any())
                {
                    var feat = Model.TopLosers.First();
                    var pos = feat.ChangePercent >= 0;
                    <a asp-controller="Home"
                       asp-action="Index"
                       asp-route-symbol="@feat.Symbol"
                       class="featured-card"
                       data-positive="@pos.ToString().ToLower()">

                        <canvas class="bg-spark"></canvas>

                        <div>
                            <span class="featured-symbol">@feat.Symbol</span>
                            <span class="featured-name">@feat.CompanyName</span>
                        </div>

                        <div class="featured-price-row">
                            <div>
                                <div class="featured-price">$@feat.Price.ToString("N2")</div>
                            </div>
                            <span class="badge-chg @(pos ? "pos" : "neg")">
                                @(pos ? "▲" : "▼")
                                @(pos ? "+" : "")@feat.ChangePercent.ToString("N2")%
                            </span>
                        </div>
                    </a>

                    <div class="list-card">
                        @foreach (var stock in Model.TopLosers.Skip(1).Take(4))
                        {
                            var sPos = stock.ChangePercent >= 0;
                            <a asp-controller="Home"
                               asp-action="Index"
                               asp-route-symbol="@stock.Symbol"
                               class="discovery-stock-row">
                                <div class="row-bar @(sPos ? "" : "neg")"></div>
                                <div class="row-info">
                                    <span class="row-sym">@stock.Symbol</span>
                                    <span class="row-co">@stock.CompanyName</span>
                                </div>
                                <div class="row-sparkline">
                                    <canvas width="64" height="28"
                                            data-positive="@sPos.ToString().ToLower()"
                                            class="row-spark-canvas"></canvas>
                                </div>
                                <div class="row-price-block">
                                    <span class="row-price">$@stock.Price.ToString("N2")</span>
                                    <span class="row-pct @(sPos ? "pos" : "neg")">
                                        @(sPos ? "+" : "")@stock.ChangePercent.ToString("N2")%
                                    </span>
                                </div>
                            </a>
                        }
                    </div>
                }
            </div>

        </div>
        @* end .discovery-grid *@

        @* ─────────────────────────────────────────
           SEARCH BAR
        ─────────────────────────────────────────── *@
        <form method="get"
              asp-controller="Stocks"
              asp-action="Index"
              id="searchForm"
              onsubmit="return true;">
            <div class="search-bar-wrap">
                <span class="search-bar-icon">⌕</span>
                <input type="text"
                       id="searchInput"
                       name="query"
                       value="@Model.Query"
                       class="search-bar-input"
                       placeholder="Search markets, companies, tickers…"
                       autocomplete="off" />
                <div class="search-kbd-hints">
                    <span class="kbd-hint">↵ Search</span>
                    <span class="kbd-hint">Esc</span>
                </div>
                <button type="submit" class="search-submit-btn">Search</button>
            </div>
        </form>

        @* ─────────────────────────────────────────
           SEARCH RESULTS
        ─────────────────────────────────────────── *@
        @if (!string.IsNullOrWhiteSpace(Model.Query))
        {
            <div class="results-panel">
                <div class="results-panel-header">
                    <div>
                        <div class="eyebrow">Search Results</div>
                        <div class="results-title">
                            @Model.SearchResults.Count
                            result@(Model.SearchResults.Count != 1 ? "s" : "")
                            for "@Model.Query"
                        </div>
                    </div>
                    <span class="results-count">
                        @Model.SearchResults.Count match@(Model.SearchResults.Count != 1 ? "es" : "")
                    </span>
                </div>

                @if (Model.SearchResults.Any())
                {
                    <table class="results-table">
                        <thead>
                            <tr>
                                <th>Symbol</th>
                                <th>Company</th>
                                <th>Region / Sector</th>
                                <th style="text-align:right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.SearchResults)
                            {
                                <tr>
                                    <td class="res-symbol">@s.Symbol</td>
                                    <td class="res-company">@s.CompanyName</td>
                                    <td class="res-region">@s.Sector</td>
                                    <td>
                                        <a asp-controller="Home"
                                           asp-action="Index"
                                           asp-route-symbol="@s.Symbol"
                                           class="view-stock-link">
                                            View ↗
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="no-results">No results found for that query.</div>
                }
            </div>
        }

    </div>
</div>
@* end .cap-page *@

@* ══════════════════════════════════════════════
   SCRIPTS
══════════════════════════════════════════════ *@

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>

<script>
    (function () {
        function getCanvasPoints(canvas, positive) {
            try {
                const points = JSON.parse(canvas.dataset.points || "[]")
                    .map(Number)
                    .filter(x => Number.isFinite(x));

                if (points.length > 1) {
                    return points;
                }
            } catch {
                // Fall through to stable placeholder.
            }

            return positive
                ? [100, 101, 100.8, 102, 103.5, 103, 104.2, 105]
                : [100, 99.4, 99.8, 98.7, 97.9, 98.1, 97.2, 96.5];
        }

        function drawSparkline(canvas, positive, w, h, filled) {
            if (!canvas || typeof Chart === 'undefined') {
                return;
            }

            canvas.width = w || canvas.width;
            canvas.height = h || canvas.height;

            const color = positive ? '#00d26a' : '#ff5256';
            const data = getCanvasPoints(canvas, positive);
            const ctx = canvas.getContext('2d');

            let background = false;

            if (filled) {
                const gradient = ctx.createLinearGradient(0, 0, 0, h || canvas.height);
                gradient.addColorStop(0, positive ? 'rgba(0,210,106,0.22)' : 'rgba(255,82,86,0.22)');
                gradient.addColorStop(1, 'rgba(0,0,0,0)');
                background = gradient;
            }

            new Chart(canvas, {
                type: 'line',
                data: {
                    labels: data.map(function (_, index) {
                        return index;
                    }),
                    datasets: [{
                        data: data,
                        borderColor: color,
                        borderWidth: 1.5,
                        pointRadius: 0,
                        tension: 0.4,
                        fill: filled,
                        backgroundColor: background || false
                    }]
                },
                options: {
                    responsive: false,
                    animation: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            enabled: false
                        }
                    },
                    scales: {
                        x: {
                            display: false
                        },
                        y: {
                            display: false
                        }
                    }
                }
            });
        }

        document.querySelectorAll('.idx-spark-canvas').forEach(function (canvas) {
            drawSparkline(canvas, canvas.dataset.positive === 'true', 80, 34, false);
        });

        document.querySelectorAll('.featured-card').forEach(function (card) {
            const canvas = card.querySelector('canvas.bg-spark');

            if (!canvas) {
                return;
            }

            const positive = card.dataset.positive === 'true';
            const width = card.offsetWidth || 280;

            drawSparkline(canvas, positive, width, 72, true);
        });

        document.querySelectorAll('canvas.row-spark-canvas').forEach(function (canvas) {
            drawSparkline(canvas, canvas.dataset.positive === 'true', 64, 28, false);
        });

        const searchInput = document.getElementById('searchInput');

        document.addEventListener('keydown', function (event) {
            if (event.key === '/' && document.activeElement !== searchInput) {
                event.preventDefault();
                searchInput?.focus();
            }

            if (event.key === 'Escape') {
                searchInput?.blur();
            }
        });

        const placeholders = [
            'Search markets, companies, tickers…',
            'Try "AAPL" or "Apple"…',
            'Try "semiconductor" or "NVDA"…',
            'Search S&P 500 constituents…'
        ];

        let placeholderIndex = 0;

        setInterval(function () {
            if (document.activeElement === searchInput) {
                return;
            }

            placeholderIndex = (placeholderIndex + 1) % placeholders.length;

            if (searchInput) {
                searchInput.placeholder = placeholders[placeholderIndex];
            }
        }, 3800);
    })();
</script>