@model CapitalOS.Models.MarketHomeViewModel
@{
    ViewData["Title"] = Model.FeaturedSymbol + " — CapitalOS";
}

@* ── Ticker tape (uses watchlist for demo; swap for live market data) ── *@
<div class="ticker-wrap">
    <div class="ticker-label">LIVE</div>
    <div class="ticker-track" id="tickerTrack">
        @foreach (var t in Model.TickerItems)
        {
            <span class="tick-item">
                <span class="tick-sym">@t.Symbol</span>
                <span class="tick-price">$@t.Price.ToString("N2")</span>
                <span class="tick-chg @(t.IsPositive ? "pos" : "neg")">
                    @(t.IsPositive ? "+" : "")@t.ChangePercent.ToString("N2")%
                </span>
            </span>
        }
    </div>
</div>
@* ── Page shell ── *@
<div class="cap-page">
    <div class="cap-inner">

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="market-error">@ViewBag.ErrorMessage</div>
        }

        <div class="market-home">

            @* ════════════════════════════════
               MAIN COLUMN
               ════════════════════════════════ *@
            <div class="market-main">

                @* Search *@
                <form method="get"
                      asp-controller="Home"
                      asp-action="Index"
                      class="stock-search-form">
                    <input type="text"
                           name="symbol"
                           value="@Model.FeaturedSymbol"
                           placeholder="Search symbol — NVDA, MSFT, AAPL…" />
                    <button type="submit">Search</button>
                </form>

                @* Stock header *@
                <div class="stock-header">
                    <div>
                        <p class="eyebrow">Featured Market</p>
                        <div class="stock-symbol-display">@Model.FeaturedSymbol</div>
                        <p class="company-name" id="companyName">Loading…</p>
                    </div>

                    <div class="price-block">
                        <span id="livePrice" class="price">—</span>
                        <span id="liveChange" class="badge-chg">—</span>
                        <span id="lastUpdated" class="last-updated">Fetching live data…</span>
                    </div>
                </div>

                @* Chart *@
                <div class="chart-card">
                    <div class="chart-toolbar" id="chartToolbar">
                        <button type="button" class="active" data-range="1D">1D</button>
                        <button type="button" data-range="1W">1W</button>
                        <button type="button" data-range="1M">1M</button>
                        <button type="button" data-range="3M">3M</button>
                        <button type="button" data-range="1Y">1Y</button>
                        <button type="button" data-range="MAX">MAX</button>
                    </div>
                    <div class="chart-shell">
                        <canvas id="mainChart" style="display:none"></canvas>
                        <div id="chartPlaceholder" class="empty-chart-message">Loading chart…</div>
                    </div>
                </div>

                @* Stats grid *@
                <div class="market-grid">
                    <div class="market-card">
                        <div class="market-card-label">Current Price</div>
                        <div class="market-card-value" id="statPrice">—</div>
                    </div>
                    <div class="market-card">
                        <div class="market-card-label">Daily Change</div>
                        <div class="market-card-value" id="statChange">—</div>
                    </div>
                    <div class="market-card">
                        <div class="market-card-label">Data Points</div>
                        <div class="market-card-value" id="statPoints">—</div>
                    </div>
                </div>

            </div>

            @* ════════════════════════════════
               SIDEBAR — Watchlist
               ════════════════════════════════ *@
            <aside class="market-sidebar">
                <div class="sidebar-heading">Watchlist</div>

                @* Tip: if your ViewModel exposes watchlist prices/changes,
                   replace the watch-view-btn with watch-price + watch-change spans *@

                <a class="watch-item"
                   asp-controller="Home"
                   asp-action="Index"
                   asp-route-symbol="NVDA">
                    <div class="watch-item-left">
                        <span class="watch-symbol">NVDA</span>
                        <span class="watch-name">NVIDIA Corporation</span>
                    </div>
                    <div class="watch-right">
                        <span class="watch-view-btn">View ↗</span>
                    </div>
                </a>

                <a class="watch-item"
                   asp-controller="Home"
                   asp-action="Index"
                   asp-route-symbol="MSFT">
                    <div class="watch-item-left">
                        <span class="watch-symbol">MSFT</span>
                        <span class="watch-name">Microsoft Corp.</span>
                    </div>
                    <div class="watch-right">
                        <span class="watch-view-btn">View ↗</span>
                    </div>
                </a>

                <a class="watch-item"
                   asp-controller="Home"
                   asp-action="Index"
                   asp-route-symbol="AMD">
                    <div class="watch-item-left">
                        <span class="watch-symbol">AMD</span>
                        <span class="watch-name">Advanced Micro Devices</span>
                    </div>
                    <div class="watch-right">
                        <span class="watch-view-btn">View ↗</span>
                    </div>
                </a>

                <a class="watch-item"
                   asp-controller="Home"
                   asp-action="Index"
                   asp-route-symbol="AAPL">
                    <div class="watch-item-left">
                        <span class="watch-symbol">AAPL</span>
                        <span class="watch-name">Apple Inc.</span>
                    </div>
                    <div class="watch-right">
                        <span class="watch-view-btn">View ↗</span>
                    </div>
                </a>

                <a class="watch-item"
                   asp-controller="Home"
                   asp-action="Index"
                   asp-route-symbol="TSLA">
                    <div class="watch-item-left">
                        <span class="watch-symbol">TSLA</span>
                        <span class="watch-name">Tesla Inc.</span>
                    </div>
                    <div class="watch-right">
                        <span class="watch-view-btn">View ↗</span>
                    </div>
                </a>

            </aside>
        </div>
    </div>
</div>

@* ══════════════════════════════════════════════
   SCRIPTS — all data loaded async after page serves
══════════════════════════════════════════════ *@

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
(function () {
    const symbol = '@Model.FeaturedSymbol';
    let chartInstance = null;

    function buildChart(labels, prices) {
        const canvas = document.getElementById('mainChart');
        const placeholder = document.getElementById('chartPlaceholder');
        if (!canvas) return;

        const positive = prices.length >= 2 && prices[prices.length - 1] >= prices[0];
        const color = positive ? '#00d26a' : '#ff5256';
        const bg0 = positive ? 'rgba(0,210,106,0.18)' : 'rgba(255,82,86,0.18)';

        canvas.style.display = 'block';
        if (placeholder) placeholder.style.display = 'none';

        if (chartInstance) chartInstance.destroy();

        const ctx = canvas.getContext('2d');
        const grad = ctx.createLinearGradient(0, 0, 0, canvas.offsetHeight || 340);
        grad.addColorStop(0, bg0);
        grad.addColorStop(1, 'rgba(0,0,0,0)');

        chartInstance = new Chart(canvas, {
            type: 'line',
            data: {
                labels,
                datasets: [{
                    label: symbol,
                    data: prices,
                    tension: 0.35,
                    borderWidth: 2.5,
                    borderColor: color,
                    pointRadius: 0,
                    pointHoverRadius: 5,
                    pointHoverBackgroundColor: color,
                    fill: true,
                    backgroundColor: grad
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: 'rgba(4,30,56,0.95)',
                        borderColor: 'rgba(255,255,255,0.12)',
                        borderWidth: 1,
                        titleColor: '#8fafc8',
                        bodyColor: '#f0f6ff',
                        bodyFont: { family: 'JetBrains Mono, monospace', weight: '700' },
                        padding: 10,
                        callbacks: { label: ctx => '$' + Number(ctx.parsed.y).toFixed(2) }
                    }
                },
                scales: {
                    x: {
                        ticks: { color: '#4d7499', font: { size: 11 }, maxTicksLimit: 8 },
                        grid: { color: 'rgba(255,255,255,0.05)' },
                        border: { color: 'rgba(255,255,255,0.07)' }
                    },
                    y: {
                        position: 'right',
                        ticks: {
                            color: '#4d7499',
                            font: { family: 'JetBrains Mono, monospace', size: 11 },
                            callback: v => '$' + Number(v).toFixed(2)
                        },
                        grid: { color: 'rgba(255,255,255,0.05)' },
                        border: { color: 'rgba(255,255,255,0.07)' }
                    }
                }
            }
        });
    }

    async function loadMarketData() {
        try {
            const res = await fetch('/api/market/' + encodeURIComponent(symbol));
            if (!res.ok) return;
            const d = await res.json();

            const price = Number(d.price);
            const pct = Number(d.changePercent);
            const prefix = pct >= 0 ? '+' : '';
            const arrow = pct >= 0 ? '▲' : '▼';
            const cls = pct >= 0 ? 'pos' : 'neg';

            const el = id => document.getElementById(id);
            if (el('companyName')) el('companyName').textContent = d.companyName || symbol;
            if (el('livePrice')) el('livePrice').textContent = '$' + price.toFixed(2);
            if (el('liveChange')) { el('liveChange').textContent = arrow + ' ' + prefix + pct.toFixed(2) + '%'; el('liveChange').className = 'badge-chg ' + cls; }
            if (el('lastUpdated')) el('lastUpdated').textContent = 'Live data loaded';
            if (el('statPrice')) el('statPrice').textContent = '$' + price.toFixed(2);
            if (el('statChange')) { el('statChange').textContent = prefix + pct.toFixed(2) + '%'; el('statChange').className = 'market-card-value ' + (pct >= 0 ? 'positive-text' : 'negative-text'); }

            if (d.chartPoints && d.chartPoints.length) {
                const labels = d.chartPoints.map(p => p.date);
                const prices = d.chartPoints.map(p => p.price);
                if (el('statPoints')) el('statPoints').textContent = prices.length;
                buildChart(labels, prices);
            } else {
                const ph = document.getElementById('chartPlaceholder');
                if (ph) ph.textContent = 'No chart data available.';
            }
        } catch (e) {
            console.error('Market data fetch failed:', e);
            const ph = document.getElementById('chartPlaceholder');
            if (ph) ph.textContent = 'Market data unavailable.';
        }
    }

    loadMarketData();
    setInterval(loadMarketData, 5 * 60 * 1000);

    document.addEventListener('keydown', function (e) {
        const tag = document.activeElement?.tagName?.toLowerCase();
        if (e.key === '/' && tag !== 'input' && tag !== 'textarea') {
            e.preventDefault();
            document.querySelector('.stock-search-form input')?.focus();
        }
    });
})();
</script>