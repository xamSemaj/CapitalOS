@model CapitalOS.Models.MarketHomeViewModel
@{
    ViewData["Title"] = Model.FeaturedSymbol + " — CapitalOS";
    var isPositive = Model.ChangePercent >= 0;
    var chartColor = isPositive ? "#00d26a" : "#ff5256";
    var chartColorBg0 = isPositive ? "rgba(0,210,106,0.18)" : "rgba(255,82,86,0.18)";
    var changePrefix = isPositive ? "+" : "";
    var changeCls = isPositive ? "pos" : "neg";
    var changeArrow = isPositive ? "▲" : "▼";
}

@* ── Ticker tape (uses watchlist for demo; swap for live market data) ── *@
<div class="ticker-wrap">
    <div class="ticker-label">LIVE</div>
    <div class="ticker-track" id="tickerTrack">
        @* Rendered server-side and duplicated in JS below for seamless loop *@
        @{
            var tickerSymbols = new[] {
                new { Sym = "AAPL",  Price = "211.84", Chg = "+1.42%", Pos = true  },
                new { Sym = "NVDA",  Price = "924.50", Chg = "+3.71%", Pos = true  },
                new { Sym = "MSFT",  Price = "418.97", Chg = "+0.83%", Pos = true  },
                new { Sym = "TSLA",  Price = "172.63", Chg = "-2.14%", Pos = false },
                new { Sym = "GOOGL", Price = "177.41", Chg = "+0.56%", Pos = true  },
                new { Sym = "META",  Price = "502.18", Chg = "+1.27%", Pos = true  },
                new { Sym = "AMZN",  Price = "189.62", Chg = "-0.38%", Pos = false },
                new { Sym = "NFLX",  Price = "648.91", Chg = "+2.05%", Pos = true  },
                new { Sym = "AMD",   Price = "168.23", Chg = "-1.04%", Pos = false },
                new { Sym = "JPM",   Price = "199.34", Chg = "-0.72%", Pos = false },
                };
        }
        @* First pass — JS duplicates this for the infinite scroll *@
        @foreach (var t in tickerSymbols)
        {
            <span class="tick-item">
                <span class="tick-sym">@t.Sym</span>
                <span class="tick-price">$@t.Price</span>
                <span class="tick-chg @(t.Pos ? "pos" : "neg")">@t.Chg</span>
            </span>
        }
    </div>
</div>

@* ── Page shell ── *@
<div class="cap-page">
    <div class="cap-inner">

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="market-error">@ViewBag.ErrorMessage</div>
        }

        <div class="market-home">

            @* ════════════════════════════════
               MAIN COLUMN
               ════════════════════════════════ *@
            <div class="market-main">

                @* Search *@
                <form method="get"
                      asp-controller="Home"
                      asp-action="Index"
                      class="stock-search-form">
                    <input type="text"
                           name="symbol"
                           value="@Model.FeaturedSymbol"
                           placeholder="Search symbol — NVDA, MSFT, AAPL…" />
                    <button type="submit">Search</button>
                </form>

                @* Stock header *@
                <div class="stock-header">
                    <div>
                        <p class="eyebrow">Featured Market</p>
                        <div class="stock-symbol-display">@Model.FeaturedSymbol</div>
                        <p class="company-name">@Model.FeaturedCompanyName</p>
                    </div>

                    <div class="price-block">
                        <span id="livePrice" class="price">
                            $@Model.CurrentPrice.ToString("N2")
                        </span>
                        <span id="liveChange"
                              class="badge-chg @changeCls">
                            @changeArrow @changePrefix@Model.ChangePercent.ToString("N2")%
                        </span>
                        <span id="lastUpdated" class="last-updated">
                            Waiting for live update…
                        </span>
                    </div>
                </div>

                @* Chart *@
                <div class="chart-card">
                    <div class="chart-toolbar" id="chartToolbar">
                        <button type="button" class="active" data-range="1D">1D</button>
                        <button type="button" data-range="1W">1W</button>
                        <button type="button" data-range="1M">1M</button>
                        <button type="button" data-range="3M">3M</button>
                        <button type="button" data-range="1Y">1Y</button>
                        <button type="button" data-range="MAX">MAX</button>
                    </div>

                    <div class="chart-shell">
                        @if (Model.ChartPoints != null && Model.ChartPoints.Any())
                        {
                            <canvas id="mainChart"></canvas>
                        }
                        else
                        {
                            <div class="empty-chart-message">No chart data available.</div>
                        }
                    </div>
                </div>

                @* Stats grid *@
                <div class="market-grid">
                    <div class="market-card">
                        <div class="market-card-label">Current Price</div>
                        <div class="market-card-value">$@Model.CurrentPrice.ToString("N2")</div>
                    </div>
                    <div class="market-card">
                        <div class="market-card-label">Daily Change</div>
                        <div class="market-card-value @(isPositive ? "positive-text" : "negative-text")">
                            @changePrefix@Model.ChangePercent.ToString("N2")%
                        </div>
                    </div>
                    <div class="market-card">
                        <div class="market-card-label">Data Points</div>
                        <div class="market-card-value">@Model.ChartPoints.Count</div>
                    </div>
                </div>

            </div>

            @* ════════════════════════════════
               SIDEBAR — Watchlist
               ════════════════════════════════ *@
            <aside class="market-sidebar">
                <div class="sidebar-heading">Watchlist</div>

                @* Tip: if your ViewModel exposes watchlist prices/changes,
                   replace the watch-view-btn with watch-price + watch-change spans *@

                <a class="watch-item"
                   asp-controller="Home"
                   asp-action="Index"
                   asp-route-symbol="NVDA">
                    <div class="watch-item-left">
                        <span class="watch-symbol">NVDA</span>
                        <span class="watch-name">NVIDIA Corporation</span>
                    </div>
                    <div class="watch-right">
                        <span class="watch-view-btn">View ↗</span>
                    </div>
                </a>

                <a class="watch-item"
                   asp-controller="Home"
                   asp-action="Index"
                   asp-route-symbol="MSFT">
                    <div class="watch-item-left">
                        <span class="watch-symbol">MSFT</span>
                        <span class="watch-name">Microsoft Corp.</span>
                    </div>
                    <div class="watch-right">
                        <span class="watch-view-btn">View ↗</span>
                    </div>
                </a>

                <a class="watch-item"
                   asp-controller="Home"
                   asp-action="Index"
                   asp-route-symbol="AMD">
                    <div class="watch-item-left">
                        <span class="watch-symbol">AMD</span>
                        <span class="watch-name">Advanced Micro Devices</span>
                    </div>
                    <div class="watch-right">
                        <span class="watch-view-btn">View ↗</span>
                    </div>
                </a>

                <a class="watch-item"
                   asp-controller="Home"
                   asp-action="Index"
                   asp-route-symbol="AAPL">
                    <div class="watch-item-left">
                        <span class="watch-symbol">AAPL</span>
                        <span class="watch-name">Apple Inc.</span>
                    </div>
                    <div class="watch-right">
                        <span class="watch-view-btn">View ↗</span>
                    </div>
                </a>

                <a class="watch-item"
                   asp-controller="Home"
                   asp-action="Index"
                   asp-route-symbol="TSLA">
                    <div class="watch-item-left">
                        <span class="watch-symbol">TSLA</span>
                        <span class="watch-name">Tesla Inc.</span>
                    </div>
                    <div class="watch-right">
                        <span class="watch-view-btn">View ↗</span>
                    </div>
                </a>

            </aside>
        </div>
    </div>
</div>

@* ══════════════════════════════════════════════
   SCRIPTS
══════════════════════════════════════════════ *@

@* Chart.js — only loaded when chart data exists *@
@if (Model.ChartPoints != null && Model.ChartPoints.Any())
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script>
        (function () {
            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                                                              Model.ChartPoints.Select(x => x.Date)));

        const prices = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                                                          Model.ChartPoints.Select(x => x.Price)));

        const chartColor = '@chartColor';
        const chartBg0   = '@chartColorBg0';

            const canvas = document.getElementById('mainChart');
            const ctx    = canvas.getContext('2d');

            /* gradient fill */
            const grad = ctx.createLinearGradient(0, 0, 0, canvas.offsetHeight || 340);
            grad.addColorStop(0, chartBg0);
            grad.addColorStop(1, 'rgba(0,0,0,0)');

            new Chart(canvas, {
                type: 'line',
                data: {
                    labels,
                    datasets: [{
                        label: '@Model.FeaturedSymbol',
                        data: prices,
                        tension: 0.35,
                        borderWidth: 2.5,
                        borderColor: chartColor,
                        pointRadius: 0,
                        pointHoverRadius: 5,
                        pointHoverBackgroundColor: chartColor,
                        fill: true,
                        backgroundColor: grad,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(4,30,56,0.95)',
                            borderColor: 'rgba(255,255,255,0.12)',
                            borderWidth: 1,
                            titleColor: '#8fafc8',
                            bodyColor: '#f0f6ff',
                            bodyFont: { family: 'JetBrains Mono, monospace', weight: '700' },
                            padding: 10,
                            callbacks: {
                                label: ctx => '$' + ctx.parsed.y.toFixed(2)
                            }
                        }
                    },
                    scales: {
                        x: {
                            ticks: { color: '#4d7499', font: { size: 11 }, maxTicksLimit: 8 },
                            grid:  { color: 'rgba(255,255,255,0.05)' },
                            border: { color: 'rgba(255,255,255,0.07)' }
                        },
                        y: {
                            position: 'right',
                            ticks: {
                                color: '#4d7499',
                                font: { family: 'JetBrains Mono, monospace', size: 11 },
                                callback: v => '$' + v.toFixed(2)
                            },
                            grid:  { color: 'rgba(255,255,255,0.05)' },
                            border: { color: 'rgba(255,255,255,0.07)' }
                        }
                    }
                }
            });

            /* ── Toolbar range switching ──
               Wire to your API endpoint — e.g. /Market/Chart?symbol=X&range=1W
               and re-render or redirect. For now toggles active state only. */
            document.getElementById('chartToolbar').addEventListener('click', e => {
                const btn = e.target.closest('button[data-range]');
                if (!btn) return;
                document.querySelectorAll('#chartToolbar button').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                /* TODO: fetch new data for btn.dataset.range and update chart.data.datasets[0].data */
            });
        })();
    </script>
}

<script>
    /* ── Ticker tape — duplicate nodes for seamless loop ── */
    (function () {
        const track = document.getElementById('tickerTrack');
        if (track) {
            const clone = track.innerHTML;
            track.innerHTML = clone + clone;   /* duplicate = seamless */
        }
    })();

    /* ── Live quote polling ── */
    (function () {
        const symbol = '@Model.FeaturedSymbol';

        async function updateLiveQuote() {
            try {
                const res = await fetch(`/Market/Quote?symbol=${encodeURIComponent(symbol)}`);
                if (!res.ok) return;

                const q = await res.json();
                const price  = Number(q.price);
                const change = Number(q.changePercent);

                document.getElementById('livePrice').textContent = '$' + price.toFixed(2);

                const liveChange = document.getElementById('liveChange');
                const prefix = change >= 0 ? '+' : '';
                const arrow  = change >= 0 ? '▲' : '▼';
                liveChange.textContent = `${arrow} ${prefix}${change.toFixed(2)}%`;
                liveChange.className   = 'badge-chg ' + (change >= 0 ? 'pos' : 'neg');

                document.getElementById('lastUpdated').textContent =
                    'Last updated ' + q.fetchedAt;
            } catch (err) {
                console.error('Live quote update failed:', err);
            }
        }

        updateLiveQuote();
        setInterval(updateLiveQuote, 5 * 60 * 1000);
    })();

    /* ── Keyboard shortcut: / focuses search ── */
    document.addEventListener('keydown', e => {
        if (e.key === '/' && document.activeElement.tagName !== 'INPUT') {
            e.preventDefault();
            document.querySelector('.stock-search-form input')?.focus();
        }
    });
</script>
