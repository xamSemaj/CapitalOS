<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <script type="importmap"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Sora:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CapitalOS.styles.css" asp-append-version="true" />
</head>

<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

        string IsActive(string controller, string action = "")
        {
            var controllerMatches = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
            var actionMatches = string.IsNullOrWhiteSpace(action) ||
            string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);

            return controllerMatches && actionMatches ? "is-active" : "";
        }
    }

    <header class="capital-header">
        <nav class="capital-nav navbar navbar-expand-md">
            <div class="capital-nav-inner">
                <a class="capital-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="capital-brand-mark">C</span>
                    <span class="capital-brand-copy">
                        <span class="capital-brand-name">CapitalOS</span>
                        <span class="capital-brand-sub">Market Terminal</span>
                    </span>
                </a>

                <button class="capital-menu-button navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#capitalNavbar"
                        aria-controls="capitalNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>

                <div class="collapse navbar-collapse capital-nav-collapse" id="capitalNavbar">
                    <ul class="capital-nav-links">
                        <li>
                            <a class="capital-nav-link @IsActive("Home", "Index")"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Overview
                            </a>
                        </li>

                        <li>
                            <a class="capital-nav-link @IsActive("Stocks", "Index")"
                               asp-area=""
                               asp-controller="Stocks"
                               asp-action="Index">
                                Markets
                            </a>
                        </li>

                     @*    <li>
                            <a class="capital-nav-link capital-nav-muted @IsActive("Home", "Privacy")"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li> *@
                    </ul>

                    <div class="capital-nav-status">
                        <span class="capital-live-dot"></span>
                        <span>Live market data</span>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="app-shell">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>